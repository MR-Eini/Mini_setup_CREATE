# Load the farmR
library(SWATfarmR)
library(tidyverse)
library(zoo)
#---------------------------------------------------
# Define the path to your SWAT project
pth <- 'A://Users//Eini//CS6//6_NSWRM//FarmR//CropRotation//clean_setup'
# Define the path to your management schedule csv
mgt <- 'farmR_input_rotation.csv'
#### sched must be similar or smaller than HRU numbers
load_farmr(paste(pth, 'rotation.farm', sep = '/'))
# extract schedule
sched1 <- rotation[[".data"]][["management"]][["schedule"]]
# keep only first occurrence of each land_use
sched_nodup <- sched1[!duplicated(sched1$land_use), ]
# write back into rotation
rotation[[".data"]][["management"]][["schedule"]] <- sched_nodup
rotation$save()
View(rotation)
