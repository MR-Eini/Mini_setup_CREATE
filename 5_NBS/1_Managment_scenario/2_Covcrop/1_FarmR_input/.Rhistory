# 1. Read the CSV
df <- read.csv("full_workflow_main/CS5_cov_crop_hru.csv", stringsAsFactors = FALSE)
# 2. Identify columns that you want to check — here everything from y_1990 onward
#    (assuming the first two columns are HRU and type)
cols_to_check <- names(df)[3:ncol(df)]
# 3. Create a logical vector: for each row, does ANY column contain "cc_"?
#    Use grepl("^cc_", x) to match strings that start with "cc_"
has_cc <- apply(df[cols_to_check], 1, function(row) any(grepl("^cc_", row)))
# 4. Subset the original data to only rows with at least 1 "cc_"
df_with_cc <- df[has_cc, ]
# 5. (Optional) Just show the HRU of those rows
df_with_cc$HRU
write.csv(df_with_cc, "CC_locations.csv")
